                  <img
                    src="https://lamartina.vtexassets.com/assets/vtex.file-manager-graphql/images/ec5d61f3-46a1-4b91-9630-6acc9fefd004___ac1b04f76e6fd1a9332f8789f9e3ea27.svg"
