                    alt="">
                </div>
              </td>
              <td>
                <div class="status-line"
                  style="box-sizing: border-box; height: 2px; width: 66px; background-color: #32BE00;  display: inline-block; vertical-align: middle">
                </div>
              </td>
              <td class=" top-header body-section" width="30px" style="max-width: 30px; width: 30px; ">
                <div>
