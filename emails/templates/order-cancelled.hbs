<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="initial-scale=1.0" />
    <!-- So that mobile webkit will display zoomed in -->
    <meta name="format-detection" content="telephone=no" />
    <!-- disable auto telephone linking in iOS -->
    <title>La Martina</title>
    <style type="text/css">
      /* Resets: see reset.css for details */
      .ReadMsgBody {
        width: 100%;
        background-color: #ebebeb;
      }
      .ExternalClass {
        width: 100%;
        background-color: #ebebeb;
      }
      .ExternalClass,
      .ExternalClass p,
      .ExternalClass span,
      .ExternalClass font,
      .ExternalClass td,
      .ExternalClass div {
        line-height: 100%;
      }
      body {
        -webkit-text-size-adjust: none;
        -ms-text-size-adjust: none;
      }
      body {
        padding: 0;
      }
      table td {
        border-collapse: collapse;
      }
      .yshortcuts a {
        border-bottom: none !important;
      }
      /* Constrain email width for small screens */
      @media screen and (max-width: 600px) {
        table[class='container'] {
          width: 100% !important;
        }
      }
      /* Give content more room on mobile */
      @media screen and (max-width: 480px) {
        .status {
          padding-bottom: 0px;
        }
      }
      /* Styles for forcing columns to rows */
      @media only screen and (max-width: 600px) {
        /* force container columns to (horizontal) blocks */
        .container {
          border-radius: 0 !important;
        }
        .no-padding-top-bottom-mobile {
          padding-top: 0;
          padding-bottom: 0;
          padding: 0 !important;
        }
        .img-product {
          width: 70px;
        }
        .side-border td {
          padding-left: 0;
        }
        .button {
          padding: 11px 0 !important;
          font-size: 13px;
          width: 100%;
        }
        .table-button {
          width: 100% !important;
        }
        td[class='force-col'] {
          display: block;
          padding-right: 0 !important;
        }
        table[class='col-3'] {
          /* unset table align="left/right" */
          float: none !important;
          width: 100% !important;
          /* change left/right padding and margins to top/bottom ones */
          padding-bottom: 12px;
          border-bottom: 1px solid #eee;
        }
        /* remove bottom border for last column/row */
        table[id='last-col-3'] {
          border-bottom: none !important;
        }
        /* align images right and shrink them a bit */
        img[class='col-3-img'] {
          float: right;
          margin-left: 6px;
          max-width: 130px;
        }
      }
      @media only screen and (max-width: 800px) {
        .status {
          width: 100% !important;
        }
        .status div {
          width: 200px !important;
        }
      }
    </style>
  </head>
  <body
    marginwidth="0"
    marginheight="0"
    bgcolor="#fff"
    style="padding: 0px 0px; color: #333"
    leftmargin="0"
    topmargin="0"
  >
    <!-- 100% wrapper (grey background) -->
    <table width="100%" cellspacing="0" border="0" bgcolor="#fff">
      <tbody>
        <tr>
          <td
            valign="top"
            bgcolor="#fff"
            align="center"
            class="no-padding-top-bottom-mobile"
            style="background-color: #fff; color: #333"
          >
            <!-- 600px container (white background) -->
            <table
              cellspacing="0"
              cellpadding="0"
              border="0"
              bgcolor="#fff"
              class="container"
              style="max-width: 600px"
            >
              <tbody>
                <tr>
                  <td
                    bgcolor="#ffffff"
                    align="left"
                    class="container-padding"
                    style="
                      background-color: #ffffff;
                      padding-left: 10px;
                      padding-right: 3px;
                      font-size: 13px;
                      line-height: 19px;
                      font-family: Helvetica, sans-serif;
                      color: #333;
                    "
                  >
                    <br />
                    <table
                      width="100%"
                      cellspacing="0"
                      cellpadding="0"
                      border="0"
                      class="columns-container"
                    >
                      <tbody>
                        <tr>
                          <td class="force-col" style="padding-right: 20px">
                            <table
                              width="100%"
                              cellspacing="0"
                              cellpadding="0"
                              border="0"
                              align="left"
                              style="
                                padding-bottom: 10px;
                                border: none;
                                border-left: 0px;
                                border-right: 0px;
                              "
                              class="col-3"
                            >
                              <tbody>
                                <tr>
                                  <td align="left">
                                    <a href="http://{{_accountInfo.HostName}}.com.br"
                                      ><img
                                        height="auto"
                                        border="0"
                                        width="auto"
                                        style="
                                          width: 25%;
                                          height: auto;
                                          border: none;
                                          border-left: 0px;
                                          border-right: 0px;
                                        "
                                        alt="{{_accountInfo.TradingName}}"
                                        src="https://lamartina.vtexcommercestable.com.br/arquivos/logo-mail.png"
                                        class="img-logo"
                                    /></a>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                        <tr>
                          <td class="force-col">
                            <!-- ### BEGIN CONTENT ### -->
                            <table
                              width="100%"
                              cellspacing="0"
                              cellpadding="0"
                              border="0"
                              bgcolor="#ffffff"
                              align="left"
                              style="padding-bottom: 0; margin-bottom: 0"
                              class="col-3"
                            >
                              <tbody>
                                <tr>
                                  <td align="left">
                                    <div
                                      style="
                                        color: #7f7f7f;
                                        font-size: 23px;
                                        font-family: sans-serif;
                                        font-weight: bold;
                                      "
                                    >
                                      Pedido cancelado
                                    </div>
                                    <span
                                      style="font-size: 16px; color: #bbb; display: inline-block"
                                      >Compra realizada el día: {{formatDate creationDate}}</span
                                    ><br /><br />
                                    <span style="font-size: 18px"
                                      >Hola <strong>{{clientProfileData.firstName}}</strong>,</span
                                    ><br />
                                    <div style="padding-top: 3px; padding-bottom: 10px">
                                      Lamentamos informarte que tu pedido ha sido cancelado.
                                    </div>
                                  </td>
                                </tr>
                              </tbody>
                            </table>

                            <!-- TABELA DE DETALHE DA ORDER -->
                            <table
                              width="100%"
                              cellspacing="0"
                              border="0"
                              style="border: 1px solid #bbb; border-bottom: 1px solid #333"
                            >
                              <tbody>
                                <tr>
                                  <td style="background-color: #f9f9f9; padding-left: 10px">
                                    <table
                                      align="left"
                                      style="padding-bottom: 0px; padding-top: 10px"
                                    >
                                      <tbody>
                                        <tr>
                                          <td>
                                            <div>
                                              <strong style="font-size: 14px"
                                                >Pedido nº
                                                <span style="font-size: 22px; display: inline-block"
                                                  >{{orderId}}</span
                                                ></strong
                                              >
                                            </div>
                                            <!-- <div style="color:#BBB;">Entregado por <strong style="display:inline-block;"><span>La Martina</span></strong></div>-->
                                            <!--<span>Tipo de entrega: <strong>{{shippingData.logisticsInfo.0.selectedSla}}</strong></span>-->
                                            <br />
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </td>
                                </tr>
                                <tr>
                                  <td style="background-color: #f9f9f9; padding-left: 10px">
                                    <table style="padding-bottom: 0px; padding-top: 5px">
                                      <tbody>
                                        <tr>
                                          <td>
                                            <div
                                              class="status"
                                              style="
                                                vertical-align: top;
                                                display: inline-block;
                                                padding-right: 5px;
                                                padding-top: 0px;
                                              "
                                            >
                                              <strong
                                                style="
                                                  vertical-align: top;
                                                  font-size: 16px;
                                                  color: #b94a48;
                                                "
                                                >X</strong
                                              >
                                              <div
                                                style="
                                                  display: inline-block;
                                                  line-height: 16px;
                                                  font-size: 10px;
                                                  color: #bbb;
                                                  padding-left: 3px;
                                                  width: 120px;
                                                "
                                              >
                                                <strong style="font-size: 14px; color: #b94a48"
                                                  >PEDIDO CANCELADO</strong
                                                >
                                              </div>
                                            </div>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </td>
                                </tr>
                                <tr>
                                  <td style="padding-bottom: 0">
                                    {{#each items}}
                                    <table
                                      width="100%"
                                      style="
                                        border-top: 1px solid #eee;
                                        padding-top: 5px;
                                        padding-bottom: 5px;
                                      "
                                    >
                                      <tbody>
                                        <tr>
                                          <td style="padding-left: 10px">
                                            <span>{{name}}</span>
                                            <table
                                              cellpadding="5"
                                              align="right"
                                              style="padding-top: 5px"
                                            >
                                              <tbody>
                                                <tr>
                                                  <td
                                                    style="
                                                      padding-left: 0;
                                                      padding-bottom: 0;
                                                      padding-top: 0;
                                                    "
                                                  >
                                                    <span
                                                      >{{quantity}}x $ {{formatCurrency
                                                      sellingPrice}}</span
                                                    ><br />
                                                  </td>
                                                </tr>
                                              </tbody>
                                            </table>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    {{/each}}
                                  </td>
                                </tr>
                              </tbody>
                            </table>

                            <br />

                            <!-- CARD DE CHANGE-->
                            {{#if changeData}} {{#each changeData.changesData}}
                            <table
                              width="100%"
                              cellspacing="0"
                              border="0"
                              style="
                                border-bottom: 1px solid #333;
                                border: 1px solid #bbb;
                                box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                              "
                            >
                              <tbody>
                                <!-- TÍTULO -->
                                <tr>
                                  <td style="background-color: #f9f9f9; padding-left: 10px">
                                    <table
                                      align="left"
                                      style="padding-bottom: 0px; padding-top: 10px"
                                    >
                                      <tbody>
                                        <tr>
                                          <td>
                                            <div>
                                              <strong style="font-size: 14px"
                                                >Cambios en el pedido</strong
                                              >
                                              <span> - {{reason}}</span>
                                            </div>
                                            <div>
                                              Valor do descuento - $ -{{ formatCurrency
                                              discountValue }}
                                            </div>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </td>
                                </tr>

                                <!-- ITENS REMOVIDOS -->
                                <tr>
                                  <td style="padding-bottom: 0">
                                    {{#each itemsAdded}}
                                    <table
                                      width="100%"
                                      style="
                                        border-top: 1px solid #eee;
                                        padding-top: 5px;
                                        padding-bottom: 5px;
                                      "
                                    >
                                      <tbody>
                                        <tr>
                                          <td style="padding-left: 10px">
                                            <span style="font-size: 12px">Item agregado (+)</span
                                            ><br />
                                            <span>{{name}}</span>
                                            <table
                                              cellpadding="5"
                                              align="right"
                                              style="padding-top: 5px"
                                            >
                                              <tbody>
                                                <tr>
                                                  <td
                                                    style="
                                                      padding-left: 0;
                                                      padding-bottom: 0;
                                                      padding-top: 0;
                                                    "
                                                  >
                                                    <span
                                                      >{{quantity}}x $ {{formatCurrency
                                                      price}}</span
                                                    ><br />
                                                  </td>
                                                </tr>
                                              </tbody>
                                            </table>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    {{/each}} {{#each itemsRemoved}}
                                    <table
                                      width="100%"
                                      style="
                                        border-top: 1px solid #eee;
                                        padding-top: 5px;
                                        padding-bottom: 5px;
                                      "
                                    >
                                      <tbody>
                                        <tr>
                                          <td style="padding-left: 10px">
                                            <span style="font-size: 12px">Item removido (-)</span
                                            ><br />
                                            <span>{{name}}</span>
                                            <table
                                              cellpadding="5"
                                              align="right"
                                              style="padding-top: 5px"
                                            >
                                              <tbody>
                                                <tr>
                                                  <td
                                                    style="
                                                      padding-left: 0;
                                                      padding-bottom: 0;
                                                      padding-top: 0;
                                                    "
                                                  >
                                                    <span
                                                      >{{quantity}}x $ {{formatCurrency
                                                      price}}</span
                                                    ><br />
                                                  </td>
                                                </tr>
                                              </tbody>
                                            </table>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    {{/each}}
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                            <br />
                            {{/each}} {{/if}}

                            <!-- TABELA DE TOTALIZADORES DA ORDER -->
                            <table
                              cellspacing="0"
                              cellpadding="4"
                              border="0"
                              align="right"
                              style="
                                margin-bottom: 15px;
                                border: 1px solid #bbb;
                                padding-top: 7px;
                                padding-bottom: 7px;
                                padding-left: 7px;
                                padding-right: 7px;
                              "
                              bgcolor="#f9f9f9"
                            >
                              <tbody>
                                {{#each totals}} {{#if value}}
                                <tr>
                                  <td valign="top" align="right" style="color: #7f7f7f">
                                    {{#eq id "Items"}}Items{{/eq}} {{#eq id
                                    "Shipping"}}Entrega{{/eq}} {{#eq id
                                    "Discounts"}}Descuentos{{/eq}} {{#eq id "Tax"}}Taxas{{/eq}}
                                    {{#eq id "Change"}}Alteraciones{{/eq}}
                                  </td>
                                  <td valign="top" align="right" style="text-align: left">
                                    $ {{formatCurrency value}}
                                  </td>
                                </tr>
                                {{/if}} {{/each}} {{#if value}}
                                <tr>
                                  <td
                                    valign="top"
                                    align="right"
                                    style="color: #7f7f7f; font-weight: bold"
                                  >
                                    Total
                                  </td>
                                  <td valign="top" align="right" style="text-align: left">
                                    $ {{formatCurrency value}}
                                  </td>
                                </tr>
                                {{/if}}
                              </tbody>
                            </table>
                          </td>
                        </tr>
                        <br />
                        <tr>
                          <td>
                            <table align="left" class="table-button">
                              <tbody>
                                <tr>
                                  <td>
                                    <a
                                      style="
                                        line-height: 19px;
                                        margin-bottom: 15px;
                                        background: #006dcc;
                                        color: #fff;
                                        display: inline-block;
                                        text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.25);
                                        text-decoration: none;
                                        padding-top: 10px;
                                        padding-right: 15px;
                                        padding-bottom: 10px;
                                        padding-left: 15px;
                                        border: 1px solid #ccc;
                                        border-color: rgba(0, 0, 0, 0.1) rgba(0, 0, 0, 0.1)
                                          rgba(0, 0, 0, 0.25);
                                        background-image: linear-gradient(
                                          rgb(0, 136, 204),
                                          rgb(0, 68, 204)
                                        );
                                        border-radius: 4px;
                                        text-align: center;
                                        margin-top: 10px;
                                      "
                                      href="https://{{_accountInfo.HostName}}.vtexcommercestable.com.br/checkout/cart/add?{{#each items}}sku={{id}}&qty={{quantity}}&seller={{seller}}&{{/each}}sc={{salesChannel}}"
                                      class="button"
                                      >Agregar productos al carrito</a
                                    >
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                        <tr>
                          <td>
                            <p>
                              Ante cualquier duda o consulta podes contactarnos por Whatsapp
                              haciendo
                              <a
                                href="https://api.whatsapp.com/send?phone=5491171367844"
                                target="_blank"
                              >
                                click aquí</a
                              >
                              o escaneando este código QR.
                            </p>
                            <div>
                              <table
                                role="presentation"
                                border="0"
                                cellpadding="0"
                                cellspacing="0"
                                align="center"
                                style="margin: auto"
                              >
                                <tr>
                                  <td style="padding: 10px; text-align: center">
                                    <img
                                      src="data:image/png;base64,"
                                      alt="Escaneá para contactarnos"
                                      width="180"
                                      height="180"
                                      style="
                                        border: 4px solid #eee;
                                        padding: 5px;
                                        border-radius: 8px;
                                      "
                                    />
                                  </td>
                                </tr>
                                <!-- Botón de WhatsApp -->
                                <tr>
                                  <td style="padding: 10px; text-align: center">
                                    <a
                                      href="https://api.whatsapp.com/send?phone=5491171367844"
                                      target="_blank"
                                      style="
                                        display: inline-block;
                                        padding: 12px 25px;
                                        background: #25d366;
                                        color: white;
                                        border-radius: 6px;
                                      "
                                    >
                                      Contactános
                                    </a>
                                  </td>
                                </tr>
                              </table>
                            </div>
                          </td>
                        </tr>
                        <tr>
                          <td>
                            <strong>Atentamente,</strong><br />
                            <strong>La Martina</strong><br /><br />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
    <!--/600px container -->
    <!--/100% wrapper-->
  </body>
</html>
